{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abinashspace.github.io/gta-hub/data/schema/vehicles.json",
  "title": "Vehicle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "required": true,
      "pattern": "^[a-z0-9-]+$",
      "description": "Permanent slug, unique within the game."
    },
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "class": {
      "type": "string"
    },
    "top_speed_kph": {
      "type": [
        "integer",
        "null"
      ]
    },
    "top_speed_mph": {
      "type": [
        "integer",
        "null"
      ]
    },
    "seats": {
      "type": [
        "integer",
        "null"
      ]
    },
    "price": {
      "type": [
        "integer",
        "null"
      ]
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified": {
      "type": "boolean",
      "required": true
    },
    "source": {
      "type": "string"
    }
  }
}