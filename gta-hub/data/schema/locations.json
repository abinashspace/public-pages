{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abinashspace.github.io/gta-hub/data/schema/locations.json",
  "title": "Location record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "required": true,
      "pattern": "^[a-z0-9-]+$",
      "description": "Permanent slug, unique within the game."
    },
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "string",
      "required": true,
      "enum": [
        "City",
        "Borough",
        "District",
        "Neighbourhood",
        "Town",
        "Landmark",
        "Interior",
        "Island",
        "Region",
        "State"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified": {
      "type": "boolean",
      "required": true
    },
    "source": {
      "type": "string"
    }
  }
}